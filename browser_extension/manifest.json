{
  "manifest_version": 3,
  "name": "Jalen",
  "version": "0.1.0",
  "description": "Lets Jalen read and act on pages inside your own Chrome, driven by the Jalen app on this machine.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Jalen",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://accounts.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
