# Copy this file to ".env" and fill in what you have.
# Jarvis starts with whatever is present and tells you what's missing.
# NEVER commit .env — .gitignore already excludes it.

# --- required for voice ---
GROQ_API_KEY=

# --- required for the Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- optional: personal Telegram account (reads your real chats) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- optional: free-tier offload for cheap questions ---
GEMINI_API_KEY=

# --- optional ---
GITHUB_TOKEN=
NOTION_TOKEN=

# --- leave EMPTY if you're using your Claude Pro subscription. ---
# Only set this if you deliberately want per-token API billing instead.
ANTHROPIC_API_KEY=
