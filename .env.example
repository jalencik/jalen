# Copy this file to ".env" and fill in what you have.
# Jalen starts with whatever is present and tells you what's missing.

# Optional path to your writing-style guide.
JALEN_VOICE_SKILL=
# NEVER commit .env — .gitignore already excludes it.

# --- required for voice ---
GROQ_API_KEY=

# --- required for the Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- optional: personal Telegram account (reads your real chats) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- optional: free-tier offload for cheap questions ---
GEMINI_API_KEY=

# --- optional: hand work to other models ---
# Jalen can delegate to a second opinion with "ask Hermes to ..." — the code is
# already written (jalen/tools/agents.py) and the openai package is installed.
# All that is missing is a key.
#
# WHY YOU MIGHT WANT THIS: every turn that reaches Claude draws on your Claude
# subscription allowance, and the local router only absorbs about a fifth of
# turns. A delegated turn costs OpenRouter pennies instead. Hermes-4-405B is
# also open-weights, so it answers some things Claude will hedge on.
#
# Get a key at openrouter.ai/keys and paste it here. Nothing else to do —
# check it worked with:  .\jalen.ps1 ready
HERMES_API_KEY=

# Same key, either name works — set whichever you prefer, not both.
OPENROUTER_API_KEY=

# Only if you want a different model or want to go direct to Nous instead of
# through OpenRouter. Defaults, from jalen/tools/agents.py:293-294:
#   HERMES_MODEL=NousResearch/Hermes-4-405B
#   HERMES_BASE_URL=https://openrouter.ai/api/v1

# --- optional: ask ChatGPT instead ---
# Same shape as Hermes. The code and the library are ready; add a key from
# platform.openai.com/api-keys and "ask ChatGPT to ..." starts working.
OPENAI_API_KEY=

# --- optional ---
GITHUB_TOKEN=
NOTION_TOKEN=

# --- leave EMPTY if you're using your Claude subscription. ---
# Only set this if you deliberately want per-token API billing instead.
# Nothing in the code reads this value, but .env is loaded into the
# environment and handed to the Claude CLI child, so a value here silently
# switches the brain off your subscription and onto metered billing.
ANTHROPIC_API_KEY=

# --- optional: which Claude Code binary the brain spawns ---
# Empty means the Agent SDK picks the claude.exe bundled inside its own wheel
# (.venv/Lib/site-packages/claude_agent_sdk/_bundled/claude.exe). That is the
# version the SDK was tested against, so empty is the supported normal state.
# Set this only to run a different native claude.exe, e.g. the one installed
# by  irm https://claude.ai/install.ps1 | iex  so the terminal and Jalen share
# one installation. A .cmd or .bat is refused and ignored: npm's Windows
# install is a claude.cmd shim and the SDK cannot spawn a batch script.
CLAUDE_CLI_PATH=

# --- optional: give Jalen his own subscription, separate from this machine's ---
# Mint one with  claude setup-token  (needs an active subscription). A value
# here overrides the machine-wide login in ~/.claude/.credentials.json for
# Jalen only, and does not expire every 8 hours the way that login does.
# Leave empty to share whatever `claude` is logged in as.
CLAUDE_CODE_OAUTH_TOKEN=
